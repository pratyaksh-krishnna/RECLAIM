# --- Database / queue ---
DATABASE_URL=postgres://reclaim:reclaim@localhost:5433/reclaim
REDIS_URL=redis://localhost:6380

# --- API ---
API_PORT=3001
JWT_SECRET=change-me-32-chars-minimum-secret

# --- Anthropic (leave STUB mode on to run fully offline) ---
ANTHROPIC_API_KEY=
