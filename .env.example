# --- Database / queue ---
DATABASE_URL=postgres://reclaim:reclaim@localhost:5433/reclaim
REDIS_URL=redis://localhost:6380

# --- API ---
API_PORT=3001
JWT_SECRET=change-me-32-chars-minimum-secret

# --- Anthropic (REQUIRED: every agent call hits the real API; no offline mode) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5

# --- Razorpay (PAYMENTS_MODE=sandbox needs no keys; payments stay mocked) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=whsec_demo_secret
PAYMENTS_MODE=sandbox    # sandbox | live-test

# --- Mailer ---
MAILER_MODE=mock         # mock only at MVP; resend adapter exists but unwired

# --- Web ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
