LLM_SMALL_MODEL=claude-haiku-4-5-20251001
LLM_MID_MODEL=claude-sonnet-5

# --- Razorpay test mode (sandbox-record mode used when keys absent) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=whsec_demo_secret
PAYMENTS_MODE=sandbox    # sandbox | live-test

# --- Mailer ---
MAILER_MODE=mock         # mock only at MVP; resend adapter exists but unwired
