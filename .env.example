# --- Database / queue ---
DATABASE_URL=postgres://reclaim:reclaim@localhost:5433/reclaim
REDIS_URL=redis://localhost:6380

# --- API ---
API_PORT=3001
JWT_SECRET=change-me-32-chars-minimum-secret

# --- LLM (REQUIRED: every agent call hits a real API; there is no offline mode) ---
LLM_PROVIDER=anthropic   # anthropic | openai

# Only the selected provider's key is required; the API refuses to boot without it.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Each provider keeps its own model id, so switching LLM_PROVIDER is a one-line
# change and the other id can safely sit here unused. Blank = the default shown.
ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_MODEL=gpt-5.6-sol
# OPENAI_BASE_URL=       # optional: OpenAI-compatible gateway or Azure endpoint

# --- Razorpay (PAYMENTS_MODE=sandbox needs no keys; payments stay mocked) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=whsec_demo_secret
PAYMENTS_MODE=sandbox    # sandbox | live-test

# --- Mailer ---
MAILER_MODE=mock         # mock only at MVP; resend adapter exists but unwired

# --- Web ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
